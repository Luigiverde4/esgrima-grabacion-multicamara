# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Configuracion de ESTA maquina: IDs de dispositivo DirectShow (solo validos en
# el PC donde se enumeraron), destino de rclone y el contador 'ultimo_asalto',
# que cambia en cada asalto. Se versiona 'config.ejemplo.json' como plantilla.
config.json

# Grabaciones: material de trabajo, no va al control de versiones.
# Las graba la app y se suben al remoto configurado con rclone.
grabaciones/

# Registros de sesion (un .txt por arranque de la app).
logs/

# Artefactos temporales del mosaico (por si queda alguno huerfano tras un corte).
_mosaico.bat
mosaico.parcial.mkv

# Binarios reservados de MediaMTX (aun sin usar; no versionar el ejecutable).
mediamtx.exe

# Ajustes locales de Claude Code (permisos de esta maquina).
.claude/settings.local.json

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store
